generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id Int @id @default(autoincrement())

    login    String @unique
    password String

    favorite   Favorite[]
    lastViewed LastViewed[]
}

model Favorite {
    id          Int  @id @default(autoincrement())
    userId      Int
    shikimoriId Int
    user        User @relation(fields: [userId], references: [id])

    @@unique([userId, shikimoriId])
}

model LastViewed {
    id          Int  @id @default(autoincrement())
    userId      Int
    shikimoriId Int
    user        User @relation(fields: [userId], references: [id])

    @@unique([userId, shikimoriId])
}
